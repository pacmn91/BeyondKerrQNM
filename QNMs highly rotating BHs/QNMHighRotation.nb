          RowBox[{"Graphics", "[", "t", "]"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"1.25", "/", "lmax"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"0", 
            RowBox[{"tablog", "[", 
