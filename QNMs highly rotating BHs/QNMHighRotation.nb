Cell[BoxData[{
 RowBox[{
  RowBox[{"ind", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"tabIm\[Omega]\[Chi]", "=", 
     RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Mu]ev", "=", 
         RowBox[{"\[Mu]list", "[", 
          RowBox[{"[", "ii", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rev", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"\[Mu]ev", ">", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"15", "/", "2"}], "-", 
              RowBox[{
               RowBox[{"Sqrt", "[", "193", "]"}], "/", "2"}]}], "]"}]}], ",", 
           "1", ",", 
           RowBox[{"Max", "[", 
            RowBox[{"r0", "/.", 
             RowBox[{"NSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"a", "/.", 
                    RowBox[{"asol", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "/.", 
                    RowBox[{"{", 
                    RowBox[{"M", "->", "1"}], "}"}]}], "/.", 
                    RowBox[{"{", 
                    RowBox[{"\[Mu]", "->", "\[Mu]ev"}], "}"}]}], ")"}], "==", 
                  "1"}], ",", 
                 RowBox[{"r0", ">=", "1"}], ",", 
                 RowBox[{"r0", "<", "3"}]}], "}"}], ",", "r0"}], "]"}]}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ind", "=", 
         RowBox[{"ind", "+", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"a", ",", 
                    RowBox[{
                    RowBox[{"ImW1simp", "/", 
                    RowBox[{"(", "ImW0", ")"}]}], "/", 
                    RowBox[{"L", "^", "2"}]}]}], "}"}], "/.", 
                  RowBox[{"{", 
                   RowBox[{"\[CapitalOmega]", "->", "\[CapitalOmega]0"}], 
                   "}"}]}], "/.", "\[CapitalOmega]sol2"}], "/.", 
                RowBox[{"asol", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"M", "->", "1"}], ",", 
                 RowBox[{"\[Mu]", "->", "\[Mu]ev"}]}], "}"}]}], "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"L", "->", "1"}], ",", 
                RowBox[{"n", "->", "0"}]}], "}"}]}], "/.", 
             RowBox[{"{", 
              RowBox[{"r", "->", "r0"}], "}"}]}], "/.", 
            RowBox[{"{", 
             RowBox[{"r0", "->", 
              RowBox[{"rev", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"1.999", 
                  RowBox[{"Exp", "[", "x", "]"}]}]}], ")"}]}]}], "}"}]}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "7"}], ",", "0", ",", "0.02"}], "}"}]}], "]"}]}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", 
         RowBox[{"Length", "[", "\[Mu]list", "]"}]}], "}"}]}], "]"}]}], ";"}],
    ",", "ii"}], "]"}]}], "Input",
